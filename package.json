{
  "name": "px0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun test/e2e-server.ts",
    "start": "bun test/e2e-server.ts",
    "build": "bun run build:client && bun run build:css",
    "build:client": "bun build src/client/landing.ts src/client/viewer.ts src/client/preview.ts --target=browser --outdir=public --external=\"/static/*\" --minify",
    "build:css": "bun scripts/build-css.ts",
    "deploy": "bun run build && wrangler deploy",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test test/ && bun run test:viewer",
    "test:viewer": "node --experimental-vm-modules --test --test-isolation=none test/viewer-loading.mjs",
    "test:e2e": "playwright test",
    "test:worker": "wrangler deploy --dry-run --outdir .wrangler/test-worker && node test/worker-integration.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "marked": "^18.1.0",
    "sanitize-html": "^2.18.0",
    "sugar-high": "2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/dompurify": "^3.2.0",
    "@types/sanitize-html": "^2.16.2",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "packageManager": "bun@1.4.2"
}
