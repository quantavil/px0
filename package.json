{
  "name": "px0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun test/e2e-server.ts",
    "start": "bun test/e2e-server.ts",
    "build": "bun run build:client",
    "build:client": "bun build src/client/landing.ts src/client/viewer.ts --target=browser --outdir=public --minify",
    "deploy": "bun run build:client && wrangler deploy",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test test/",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "hono": "^4.13.9",
    "marked": "^18.0.14",
    "sugar-high": "2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/dompurify": "^3.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.141.0"
  }
}
