{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "bun-types"]
  },
  "include": ["src/**/*", "test/**/*", "e2e/**/*", "playwright.config.ts"]
}
